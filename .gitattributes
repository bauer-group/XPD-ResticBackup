# =============================================================================
# XPD-ResticBackup - Git Attributes
# =============================================================================
# LOAD-BEARING, NOT COSMETIC.
#
# Development happens on Windows; the entire product is POSIX shell executed on
# Ubuntu. A CRLF install.sh served from raw.githubusercontent.com fails on every
# target host with "bash\r: no such file or directory" - an error message that
# names nothing useful and costs an hour to diagnose.
#
# Everything that is read by a shell, systemd, or the kernel is pinned to LF.
# =============================================================================

* text=auto eol=lf

# --- Shell and anything executed on a Linux host -----------------------------
*.sh        text eol=lf
*.bash      text eol=lf
*.bats      text eol=lf
*.exclude   text eol=lf
*.conf      text eol=lf
*.env       text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.j2        text eol=lf
Makefile    text eol=lf
Dockerfile* text eol=lf

# --- Data and docs -----------------------------------------------------------
*.md        text eol=lf
*.MD        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf

# --- Windows-only helpers keep CRLF ------------------------------------------
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# --- Binary / verbatim -------------------------------------------------------
# The vendored GPG key must never be line-ending normalised: any rewrite
# invalidates the armor checksum and the installer would reject it.
*.asc       -text
*.gpg       binary
*.png       binary
*.jpg       binary
*.pdf       binary
*.tar.gz    binary
*.bz2       binary

# --- Linguist ----------------------------------------------------------------
tests/fixtures/**  linguist-vendored
share/restic/*.asc linguist-vendored
