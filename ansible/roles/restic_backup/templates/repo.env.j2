#jinja2: trim_blocks: True, lstrip_blocks: True
{% set repository = restic_backup_repo_env_repository | default(restic_backup_repository) %}
{% set key_file = restic_backup_repo_env_key_file | default(restic_backup_repo_key) %}
{% set access_key = restic_backup_repo_env_access_key | default(restic_backup_s3_access_key) %}
{% set secret_key = restic_backup_repo_env_secret_key | default(restic_backup_s3_secret_key) %}
{% set role = restic_backup_repo_env_role | default('primary') %}
# =============================================================================
# bg-backup - {{ role }} repository credentials
# =============================================================================
# MANAGED BY ANSIBLE (role: restic_backup) - DO NOT EDIT ON THE HOST.
# Mode 0400, owner root.
#
# This file is a plain sourceable shell fragment on purpose. During a disaster
# recovery you can drive restic by hand, with no bg-backup involved at all:
#
#     source {{ restic_backup_repo_env if role == 'primary' else restic_backup_secondary_repo_env }} && restic snapshots
#
# That is a design goal: the tool must never be a single point of failure for
# reading its own backups.
#
# THE PASSPHRASE IS NOT IN THIS FILE. It lives in a separate 0400 file reached
# through RESTIC_PASSWORD_FILE, because --stdin-from-command and every hook
# spawn child processes that inherit this environment - an inline
# RESTIC_PASSWORD would be readable by every database dump command we run.
# =============================================================================

# --- Repository --------------------------------------------------------------
# The path ends with this host's inventory name, verbatim. The bucket is shared
# across servers and `bg-backup doctor` fails when the prefix does not match:
# a copied-and-pasted prefix is how one host's retention silently deletes
# another host's snapshots.
export RESTIC_REPOSITORY='{{ repository }}'

export RESTIC_PASSWORD_FILE='{{ key_file }}'
{% if repository is match('^s3:') %}

# --- Backend credentials -----------------------------------------------------
# This identity is scoped to the prefix above. The policy needs GetObject,
# PutObject and multipart on <prefix>/*, ListBucket limited to that prefix, and
# DeleteObject ONLY under <prefix>/locks/*.
#
# Do not deny DeleteObject outright: restic writes a lock object on every run
# and removes it on exit. With deletes fully denied every run leaves a stale
# lock behind, and by the third run the repository needs an unlock that also
# cannot succeed.
{% if restic_backup_prune_local | bool %}
#
# NOTE: restic_backup_prune_local is TRUE on this host, so this identity is
# expected to be allowed to delete repository objects. That also means root on
# this machine can destroy its own backup history - keep the list of such hosts
# short and deliberate.
{% endif %}
export AWS_ACCESS_KEY_ID='{{ access_key }}'
export AWS_SECRET_ACCESS_KEY='{{ secret_key }}'

# MinIO ignores the region, but the AWS SDK insists on a syntactically valid
# one. If `restic init` fails with a region error, use 'us-east-1'.
export AWS_DEFAULT_REGION='{{ restic_backup_s3_region }}'
{% endif %}

# --- Tuning ------------------------------------------------------------------
export RESTIC_COMPRESSION='{{ restic_backup_compression }}'
export RESTIC_CACHE_DIR='{{ restic_backup_statedir }}/cache'

# Keep restic's own progress meter out of the journal when running under
# systemd: at the default rate it writes several lines per second for hours.
export RESTIC_PROGRESS_FPS='0.016'
