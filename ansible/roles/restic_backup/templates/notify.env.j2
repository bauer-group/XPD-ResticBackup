#jinja2: trim_blocks: True, lstrip_blocks: True
# =============================================================================
# bg-backup - notifier credentials
# =============================================================================
# MANAGED BY ANSIBLE (role: restic_backup) - DO NOT EDIT ON THE HOST.
# Mode 0400, owner root. Read by systemd through an EnvironmentFile drop-in on
# the bg-backup units.
#
# WHY THIS FILE EXISTS AT ALL
# A Kuma push URL and a Teams webhook are bearer credentials: whoever has the
# URL can post as this host's monitor. bg-backup.conf is mode 0640 and gets
# read over the shoulder, pasted into tickets and diffed in review, so these
# three values live here instead - and bg-backup.conf deliberately does not
# assign the keys at all, because its precedence is
#     defaults < bg-backup.conf < conf.d < ENVIRONMENT < flags
# and an assignment of "" in the config file would beat the environment and
# silently disable the notifier.
#
# NO 'export' KEYWORD BELOW. systemd's EnvironmentFile parser is not a shell:
# it reads plain KEY=value lines, and a line starting with "export " yields the
# variable name "export BGB_MONITOR_..." - which is not an error, just a
# notifier that never fires.
#
# A manual `bg-backup backup <job>` from an interactive shell does NOT see this
# file (systemd is what injects it). That is intentional: an operator watching
# a run does not need the dead-man's-switch ping, and a test run must not close
# an alert that a scheduled failure opened.
# =============================================================================
{% if restic_backup_kuma_push_url | length > 0 %}

# Uptime Kuma push monitor - the dead-man's switch. Kuma alerts when the push
# does NOT arrive, which is the failure mode a "send mail on error" script can
# never detect, because a job that never runs sends nothing.
BGB_MONITOR_KUMA_PUSH_URL={{ restic_backup_kuma_push_url }}
{% endif %}
{% if restic_backup_teams_webhook_url | length > 0 %}

# Microsoft Teams incoming webhook (Power Automate / Workflows URL).
BGB_MONITOR_TEAMS_WEBHOOK_URL={{ restic_backup_teams_webhook_url }}
{% endif %}
{% if restic_backup_webhook_url | length > 0 %}

# Generic JSON webhook.
BGB_MONITOR_WEBHOOK_URL={{ restic_backup_webhook_url }}
{% endif %}
