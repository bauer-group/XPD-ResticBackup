# =============================================================================
# bg-backup - primary repository credentials
# =============================================================================
# Installed to /etc/bg-backup/credentials/repo.env, mode 0400, owner root.
#
# This file is deliberately a plain, sourceable shell fragment. During a
# disaster recovery you can do exactly this and drive restic by hand, with no
# bg-backup involved at all:
#
#     source /etc/bg-backup/credentials/repo.env && restic snapshots
#
# That is a design goal, not an accident: the tool must never be a single point
# of failure for reading its own backups.
#
# THE REPOSITORY PASSPHRASE IS NOT IN THIS FILE. It lives in repo.key (0400) and
# is reached through RESTIC_PASSWORD_FILE, because --stdin-from-command and every
# hook spawn child processes that inherit this environment. An inline
# RESTIC_PASSWORD would be readable by every database dump command we run.
# =============================================================================

# --- Repository --------------------------------------------------------------
# The path MUST end with this host's FQDN. The bucket is shared across servers,
# and `bg-backup doctor` fails if the prefix does not match: a copied-and-pasted
# prefix is how one host's retention silently deletes another host's snapshots.
export RESTIC_REPOSITORY='s3:https://<endpoint>/<bucket>/<this-host-fqdn>'

export RESTIC_PASSWORD_FILE='/etc/bg-backup/credentials/repo.key'

# --- Backend credentials -----------------------------------------------------
# Scope this identity to the prefix above. The policy needs GetObject,
# PutObject and multipart on <prefix>/*, ListBucket limited to that prefix, and
# DeleteObject ONLY under <prefix>/locks/*.
#
# Do not deny DeleteObject outright: restic writes a lock object on every run
# and removes it on exit. With deletes fully denied, every run leaves a stale
# lock behind and by the third run the repository needs a `restic unlock` that
# also cannot succeed.
export AWS_ACCESS_KEY_ID='<access-key-id>'
export AWS_SECRET_ACCESS_KEY='<secret-access-key>'

# MinIO ignores the region, but the AWS SDK insists on a syntactically valid
# one. If `restic init` fails with a region error, use 'us-east-1'.
export AWS_DEFAULT_REGION='<region>'

# --- Tuning ------------------------------------------------------------------
export RESTIC_COMPRESSION='auto'
export RESTIC_CACHE_DIR='/var/lib/bg-backup/cache'

# Keep restic's own progress output out of the log when running under systemd.
export RESTIC_PROGRESS_FPS='0.016'
